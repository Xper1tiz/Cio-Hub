local function decipherCode()
    local paper = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("LibraryHintPaper")
    local hints = LocalPlayer.PlayerGui:FindFirstChild("PermUI") and LocalPlayer.PlayerGui.PermUI:FindFirstChild("Hints")
    local code = {"_", "_", "_", "_", "_"}
    if not paper or not hints then return table.concat(code) end
    local ui = paper:FindFirstChild("UI")
    if not ui then return table.concat(code) end
    for _, digit in pairs(ui:GetChildren()) do
        local index = tonumber(digit.Name)
        if index and digit:IsA("ImageLabel") then
            for _, hint in pairs(hints:GetChildren()) do
                local label = hint:FindFirstChild("TextLabel")
                if hint:IsA("ImageLabel") and hint.Visible and label and digit.ImageRectOffset == hint.ImageRectOffset then code[index] = label.Text end
            end
        end
    end
    return table.concat(code)
end

