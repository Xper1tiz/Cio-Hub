    SendNotification("System", "Unloading Cio Hub...", 2)
    wait(0.5)
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(UIBlur, TweenInfo.new(0.4), {Size = 0}):Play()
    wait(0.4)
    if MonsterNotifyConnection then MonsterNotifyConnection:Disconnect() end
    CioGUI:Destroy()
    NotifGUI:Destroy()
    UIBlur:Destroy()
end)

CloseBtn.MouseButton1Click:Connect(function()
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(UIBlur, TweenInfo.new(0.4), {Size = 0}):Play()
    wait(0.4)
    if MonsterNotifyConnection then MonsterNotifyConnection:Disconnect() end
    CioGUI:Destroy()
    NotifGUI:Destroy()
    UIBlur:Destroy()
end)
