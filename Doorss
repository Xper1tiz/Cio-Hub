local function scanObjects()
    local rooms = Workspace:FindFirstChild("CurrentRooms")
    if not rooms then return end
    for _, room in pairs(rooms:GetChildren()) do
        for _, object in pairs(room:GetDescendants()) do
            local name = object.Name
            if Flags.Door and name == "RoomExit" then addEsp(object, "Door " .. room.Name, Color3.fromRGB(0, 255, 0), "Door")
            elseif Flags.Keys and (name == "KeyObtain" or name == "LeverForGate") then addEsp(object, name == "KeyObtain" and "Key" or "Lever", Color3.fromRGB(90, 255, 40), "Keys")
            elseif Flags.Books and (name == "LiveHintBook" or name == "LiveBreakerPolePickup") then addEsp(object, name == "LiveHintBook" and "Book" or "Breaker", Color3.fromRGB(160, 190, 255), "Books")
            elseif Flags.Entities and EntityNames[name] then addEsp(object, name:gsub("Moving", ""), Color3.fromRGB(255, 25, 25), "Entities")
            elseif Flags.Figure and name == "FigureRig" then addEsp(object, "Figure", Color3.fromRGB(255, 25, 25), "Figure")
            elseif Flags.Lockers and (name == "Wardrobe" or name == "Rooms_Locker" or name == "Rooms_Locker_Fridge") then addEsp(object, "Locker", Color3.fromRGB(145, 100, 25), "Lockers")
            elseif Flags.Chests and (name == "ChestBox" or name == "ChestBoxLocked") then addEsp(object, name == "ChestBox" and "Chest" or "Locked Chest", Color3.fromRGB(205, 120, 255), "Chests")
            elseif Flags.Gold and name == "GoldPile" and (object:GetAttribute("GoldValue") or 0) >= EspSettings.GoldMin then addEsp(object, "GoldPile [" .. tostring(object:GetAttribute("GoldValue") or 0) .. "]", Color3.fromRGB(255, 255, 0), "Gold")
            elseif Flags.Items and object:IsA("Model") and (object:GetAttribute("Pickup") or object:GetAttribute("PropType")) then addEsp(object, name, Color3.fromRGB(160, 190, 255), "Items")
            end
        end
    end
end

local function categoryEnabled(category)
    return Flags[category] == true
end

local function updateEsp()
    local character = LocalPlayer.Character
    local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Collision"))
    for object, data in pairs(activeEsp) do
        local position = object.Parent and objectPosition(object)
        local distance = root and position and (root.Position - position).Magnitude
        if not position or not categoryEnabled(data.Category) or not distance or distance > EspSettings.Distance then
            removeEsp(object)
        else
            data.Billboard.Enabled = EspSettings.Text
            data.Billboard.StudsOffset = Vector3.new(0, EspSettings.Offset, 0)
            data.Label.TextSize = EspSettings.TextSize
            data.Label.Text = data.Label.Text:match("^[^%[]+") .. " [" .. math.floor(distance) .. "]"
        end
    end
end

