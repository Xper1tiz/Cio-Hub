local function removeEsp(object)
    local data = activeEsp[object]
    if not data then return end
    for _, instance in pairs(data.Instances) do
        if instance and instance.Parent then instance:Destroy() end
    end
    activeEsp[object] = nil
end

local function addEsp(object, label, color, category)
    if not object or not object.Parent or activeEsp[object] then return end
    local adornee = object
    if object:IsA("Model") and not object.PrimaryPart then
        adornee = object:FindFirstChildWhichIsA("BasePart", true)
    end
    if not adornee then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "_Ne0eDoorsESP"
    highlight.Adornee = object
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.5
    highlight.Parent = object
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_Ne0eDoorsLabel"
    billboard.Adornee = adornee
    billboard.Size = UDim2.fromOffset(150, 30)
    billboard.StudsOffset = Vector3.new(0, EspSettings.Offset, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = EspSettings.Text
    billboard.Parent = adornee
    local text = Instance.new("TextLabel")
    text.Name = "Label"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.TextColor3 = color
    text.TextStrokeTransparency = 0
    text.Font = Enum.Font.GothamBold
    text.TextSize = EspSettings.TextSize
    text.Text = label
    text.Parent = billboard
    activeEsp[object] = {Instances = {highlight, billboard}, Label = text, Billboard = billboard, Category = category}
end

local function objectPosition(object)
