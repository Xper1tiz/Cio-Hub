local IsMinimized = false
local function ToggleMinimize()
    if not IsMinimized then
        IsMinimized = true
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
        TweenService:Create(UIBlur, TweenInfo.new(0.4), {Size = 0}):Play()
        wait(0.3)
        MainFrame.Visible = false
        LogoBtn.Visible = true
        LogoBtn.Position = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset)
        TweenService:Create(LogoBtn, TweenInfo.new(0.5, Enum.EasingStyle.Elastic), {Size = UDim2.new(0, 55, 0, 55)}):Play()
    else
        IsMinimized = false
        TweenService:Create(LogoBtn, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 0, 0)}):Play()
        wait(0.2)
        LogoBtn.Visible = false
        MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 700, 0, 450)}):Play()
        TweenService:Create(UIBlur, TweenInfo.new(0.5), {Size = 15}):Play()
    end
end

MiniBtn.MouseButton1Click:Connect(ToggleMinimize)
LogoBtn.MouseButton1Click:Connect(ToggleMinimize)

