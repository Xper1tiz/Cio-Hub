    local function UpdateSlider(Input)
        local SizeX = math.max(0, math.min(1, (Input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X))
        TweenService:Create(Fill, TweenInfo.new(0.1), {Size = UDim2.new(SizeX, 0, 1, 0)}):Play()
        local NewValue = math.floor((Min + ((Max - Min) * SizeX)) / Step + 0.5) * Step
        ValueLabel.Text = tostring(NewValue)
        pcall(Callback, NewValue)
    end

    BarBg.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
            UpdateSlider(Input)
        end
    end)
    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(Input)
        if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(Input) end
    end)
